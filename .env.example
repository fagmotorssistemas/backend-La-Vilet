PORT=3010

# disabled | test | live
META_MODE=disabled

META_DATASET_ID=923439043758658
META_PIXEL_ID=923439043758658
META_API_VERSION=v21.0

# Solo en DigitalOcean (nunca en Vercel / nunca en git)
# CAPI web (pixel / website). No usar para LeadSubmitted BM.
META_CAPI_ACCESS_TOKEN=
# CAPI WhatsApp BM (LeadSubmitted). Distinto del token web; scopes WA.
META_WA_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Compartido Vercel ↔ DigitalOcean (distinto del token Meta)
META_CAPI_INTERNAL_SECRET=change-me-to-a-long-random-string

CORS_ORIGINS=https://www.lavilett.com,https://lavilett.com,http://localhost:3000

# Local: ./data/...  |  Docker/DigitalOcean: /data/lavilet-meta-capi.db
DATABASE_PATH=./data/lavilet-meta-capi.db

OUTBOX_ENABLED=true
OUTBOX_POLL_MS=5000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_RETENTION_DAYS=90
META_HTTP_TIMEOUT_MS=10000

# Core Setup / configuración básica: sin custom_data; event_source_url = origen.
# Default true si se omite. false solo cuando Meta retire la restricción.
META_CORE_SETUP_CONSERVATIVE=true

# Drenado periódico Supabase → Nest (independiente del tráfico web)
# false: arranca sin credenciales. true: exige SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
SUPABASE_DRAIN_ENABLED=false
SUPABASE_DRAIN_POLL_MS=15000
SUPABASE_DRAIN_BATCH_SIZE=20
SUPABASE_DRAIN_LOCK_TTL_MS=60000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Schedule (default off — cero escrituras / envío Schedule)
META_SCHEDULE_RECOVER_ENABLED=false
META_SCHEDULE_DELIVERY_ENABLED=false

# WhatsApp LeadSubmitted BM (default off)
# Apaga también claim SQLite de eventos ya encolados (Lead/VC siguen).
META_WA_LEAD_SUBMITTED_DELIVERY_ENABLED=false

