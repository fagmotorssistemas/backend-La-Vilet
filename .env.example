PORT=3010

# disabled | test | live
META_MODE=disabled

META_DATASET_ID=923439043758658
META_PIXEL_ID=923439043758658
META_API_VERSION=v21.0

# Solo en DigitalOcean (nunca en Vercel / nunca en git)
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Compartido Vercel ↔ DigitalOcean (distinto del token Meta)
META_CAPI_INTERNAL_SECRET=change-me-to-a-long-random-string

CORS_ORIGINS=https://www.lavilett.com,https://lavilett.com,http://localhost:3000

# Local: ./data/...  |  Docker/DigitalOcean: /data/lavilet-meta-capi.db
DATABASE_PATH=./data/lavilet-meta-capi.db

OUTBOX_ENABLED=true
OUTBOX_POLL_MS=5000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_RETENTION_DAYS=90
META_HTTP_TIMEOUT_MS=10000

# Drenado periódico Supabase → Nest (independiente del tráfico web)
# false: arranca sin credenciales. true: exige SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
SUPABASE_DRAIN_ENABLED=false
SUPABASE_DRAIN_POLL_MS=15000
SUPABASE_DRAIN_BATCH_SIZE=20
SUPABASE_DRAIN_LOCK_TTL_MS=60000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
